; Engine configuration file.
config_version=5

[application]
config/name="KOTA JANJI — Petualangan Anggaran"
config/description="Platformer retro 8-bit satir fiksi. Gratis, offline, tanpa iklan."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")

[display]
